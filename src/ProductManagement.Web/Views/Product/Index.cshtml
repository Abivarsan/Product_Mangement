@model ProductManagement.Web.Models.ProductListViewModel
@{
    ViewData["Title"] = "Product Catalog";
}

<div class="container-fluid px-lg-4 mt-4">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>Product Catalog
            </h2>
            <p class="text-muted mb-0 small">
                Manage products, monitor real-time stock levels, and track inventory valuation.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Report" asp-action="Index" class="btn btn-outline-primary shadow-sm">
                <i class="bi bi-graph-up me-1"></i> View Inventory Reports
            </a>
            <button type="button" class="btn btn-primary shadow-sm" id="btnOpenAddModal">
                <i class="bi bi-plus-circle me-1"></i> Add New Product
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card d-flex align-items-center gap-3">
                <div class="kpi-icon-bubble kpi-icon-blue">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Total Products</span>
                    <h3 class="fw-bold mb-0 text-dark" id="statTotalProducts">@Model.TotalProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card d-flex align-items-center gap-3">
                <div class="kpi-icon-bubble kpi-icon-green">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Total Stock Value</span>
                    <h3 class="fw-bold mb-0 text-dark" id="statTotalValue">@Model.TotalInventoryValue.ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card d-flex align-items-center gap-3">
                <div class="kpi-icon-bubble kpi-icon-purple">
                    <i class="bi bi-layers-fill"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Total Stock Units</span>
                    <h3 class="fw-bold mb-0 text-dark" id="statTotalUnits">@Model.TotalStockUnits</h3>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card d-flex align-items-center gap-3">
                <div class="kpi-icon-bubble kpi-icon-amber">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium text-uppercase">Low Stock (&lt; 10)</span>
                    <h3 class="fw-bold mb-0 text-danger" id="statLowStock">@Model.LowStockCount</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Products Table Card -->
    <div class="modern-card">
        <!-- Search and Filter Toolbar -->
        <div class="modern-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1" style="max-width: 600px;">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Search by product name or category..." />
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <select id="categoryFilter" class="form-select form-select-sm" style="min-width: 170px;">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRefreshTable" title="Refresh Table">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>

        <!-- Responsive Products Table -->
        <div class="table-responsive">
            <table class="table table-modern table-hover align-middle" id="productsTable">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Stock</th>
                        <th class="text-end">Stock Value</th>
                        <th class="text-center" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="productsTableBody">
                    @if (!Model.Products.Any())
                    {
                        <tr id="emptyRow">
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No products found. Click "Add New Product" to get started.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Products)
                        {
                            <tr data-id="@item.Id" data-category="@item.Category">
                                <td class="fw-semibold text-secondary">#@item.Id</td>
                                <td>
                                    <span class="fw-semibold text-dark product-name">@item.Name</span>
                                </td>
                                <td>
                                    <span class="badge-category product-category">@item.Category</span>
                                </td>
                                <td class="text-end fw-semibold text-dark product-price">
                                    @item.Price.ToString("C2")
                                </td>
                                <td class="text-center product-stock">
                                    @if (item.Stock < 10)
                                    {
                                        <span class="badge badge-stock-low px-2 py-1" title="Low stock alert!">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>@item.Stock units
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-stock-healthy px-2 py-1">
                                            @item.Stock units
                                        </span>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-secondary product-value">
                                    @item.StockValue.ToString("C2")
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary btn-edit" data-id="@item.Id" title="Edit Product">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-delete" data-id="@item.Id" data-name="@item.Name" title="Delete Product">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add / Edit Product -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="productModalLabel">
                    <i class="bi bi-box-seam me-2 text-primary"></i>Add New Product
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="productForm" novalidate>
                <div class="modal-body p-4">
                    <input type="hidden" id="productId" name="Id" value="0" />

                    <!-- Alert message area inside modal -->
                    <div id="modalAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="mb-3">
                        <label for="productName" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="productName" name="Name" required maxlength="100" placeholder="e.g. Ultra HD Monitor" />
                        <div class="invalid-feedback">Product name must be between 2 and 100 characters.</div>
                    </div>

                    <div class="mb-3">
                        <label for="productCategory" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="productCategory" name="Category" required maxlength="50" placeholder="e.g. Electronics, Furniture" list="categoryOptions" />
                        <datalist id="categoryOptions">
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat"></option>
                            }
                        </datalist>
                        <div class="invalid-feedback">Category is required (2–50 characters).</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="productPrice" class="form-label fw-semibold">Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" min="0.01" max="9999999" class="form-control" id="productPrice" name="Price" required placeholder="0.00" />
                                <div class="invalid-feedback">Price must be greater than 0.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="productStock" class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                            <input type="number" min="0" max="1000000" class="form-control" id="productStock" name="Stock" required placeholder="0" />
                            <div class="invalid-feedback">Stock cannot be negative.</div>
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                Quantities under 10 units trigger a low stock alert.
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveProduct">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="saveSpinner"></span>
                        <i class="bi bi-check2-circle me-1" id="saveIcon"></i> Save Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4 pb-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-trash3-fill" style="font-size: 3rem;"></i>
                </div>
                <h5 class="fw-bold mb-2">Delete Product?</h5>
                <p class="text-muted small mb-0">
                    Are you sure you want to delete <span class="fw-bold text-dark" id="deleteProductName"></span>?
                </p>
                <input type="hidden" id="deleteProductId" />
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <span class="spinner-border spinner-border-sm me-1 d-none" id="deleteSpinner"></span>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product-crud.js" asp-append-version="true"></script>
}
